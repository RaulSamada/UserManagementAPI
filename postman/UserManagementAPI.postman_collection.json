    {
      "name": "Handle Unhandled Exception",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 500 Internal Server Error\", function () {",
              "    pm.response.to.have.status(500);",
              "});",
              "",
              "pm.test(\"Returns a safe standardized server-error problem\", function () {",
              "    const problem = pm.response.json();",
              "    const responseText = pm.response.text();",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "    pm.expect(problem.status).to.eql(500);",
              "    pm.expect(problem.title).to.eql(\"An unexpected error occurred\");",
              "    pm.expect(problem.traceId).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(responseText).not.to.include(\"InvalidOperationException\");",
              "    pm.expect(responseText).not.to.include(\"Simulated unhandled exception\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
