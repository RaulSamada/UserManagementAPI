  "item": [
    {
      "name": "Get OpenAPI Document",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Documents every user endpoint\", function () {",
              "    const document = pm.response.json();",
              "    pm.expect(document.paths[\"/api/users\"].get).to.exist;",
              "    pm.expect(document.paths[\"/api/users\"].post).to.exist;",
              "    pm.expect(document.paths[\"/api/users/{id}\"].get).to.exist;",
              "    pm.expect(document.paths[\"/api/users/{id}\"].put).to.exist;",
              "    pm.expect(document.paths[\"/api/users/{id}\"].delete).to.exist;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/openapi/v1.json",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "openapi",
            "v1.json"
          ]
        },
        "description": "Confirms that the Development environment publishes the OpenAPI document."
      }
    },
    {
      "name": "Reject Missing Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test(\"Returns a standardized authentication problem\", function () {",
              "    const problem = pm.response.json();",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "    pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"Bearer\");",
              "    pm.expect(problem.status).to.eql(401);",
              "    pm.expect(problem.title).to.eql(\"Unauthorized\");",
              "    pm.expect(problem.traceId).to.be.a(\"string\").and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/problem+json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "description": "Confirms that a protected endpoint rejects a request without a bearer token."
      }
    },
