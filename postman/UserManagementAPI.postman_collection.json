    {
      "name": "Create User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const uniqueSuffix = `${Date.now()}-${Math.floor(Math.random() * 100000)}`;",
              "pm.collectionVariables.set(\"testEmail\", `ada.${uniqueSuffix}@techhive.example`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const user = pm.response.json();",
              "",
              "pm.test(\"Returns the created user\", function () {",
              "    pm.expect(user.id).to.be.a(\"number\");",
              "    pm.expect(user.name).to.eql(\"Ada Lovelace\");",
              "    pm.expect(user.email).to.eql(pm.collectionVariables.get(\"testEmail\"));",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(`/api/users/${user.id}`);",
              "});",
              "",
              "pm.collectionVariables.set(\"userId\", user.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"{{testEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      }
